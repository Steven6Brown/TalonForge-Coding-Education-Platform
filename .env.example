# Variable NAMES only. Never commit real values.

# Which brand/tenant config to build (see src/brands/index.ts). Default: talonforge
NEXT_PUBLIC_BRAND=talonforge

# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional accounts (Supabase). Leave AUTH_ENABLED=false until configured. See docs/AUTH.md ----
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional AI helper answers ("Talon"). Leave empty to keep the helper built-in/offline only ----
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. When set, learners who opt in send their question

# ---- Local development only ----
# Alternate Next.js build folder so a verification build does not overwrite a running `next dev`.
# Leave unset in production and on Vercel.
NEXT_DIST_DIR=
